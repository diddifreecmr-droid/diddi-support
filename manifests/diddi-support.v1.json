{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "protocol": "diddi.module.v1",
  "module": "diddi-support",
  "version": "1.0",
  "status": "proposed",
  "display_name": "DiddiSupport",
  "runtime": {
    "current_host": "diddicomms",
    "extraction_allowed": true,
    "separate_service_allowed_later": true,
    "source_of_truth": "diddi-support"
  },
  "ownership": {
    "owns": [
      "support_cases",
      "support_messages",
      "support_assignments",
      "support_priorities",
      "support_actions",
      "support_sos_state",
      "support_audit_history"
    ],
    "does_not_own": [
      "rides",
      "orders",
      "deliveries",
      "identities",
      "binary_file_storage",
      "payment_execution"
    ]
  },
  "identity": {
    "audience": "diddi-support",
    "issuer": "diddifree-id",
    "required_service_claims": {
      "token_type": "service",
      "status": "active"
    },
    "required_headers": [
      "Authorization",
      "X-Client-ID",
      "X-Request-ID"
    ],
    "scopes": [
      "diddi-support:cases:create",
      "diddi-support:cases:read",
      "diddi-support:cases:write",
      "diddi-support:messages:write",
      "diddi-support:attachments:read",
      "diddi-support:sos:create",
      "diddi-support:sos:operate",
      "diddi-support:audit:read"
    ]
  },
  "resource_reference": {
    "contextual_required_fields": [
      "origin_service",
      "resource_type",
      "resource_id"
    ],
    "general_case": {
      "allowed": true,
      "required_absent_fields": [
        "origin_service",
        "resource_type",
        "resource_id"
      ],
      "allowed_callers": ["diddicomms"]
    },
    "partial_reference_error": "SUPPORT_RESOURCE_REFERENCE_INCOMPLETE",
    "optional_fields": [
      "origin_report_id"
    ],
    "supported_resources": [
      {
        "origin_service": "diddigo",
        "resource_type": "ride",
        "context_scope": "diddigo:support-context:read"
      },
      {
        "origin_service": "diddifood",
        "resource_type": "order",
        "context_scope": "diddifood:support-context:read",
        "status": "implemented"
      },
      {
        "origin_service": "diddisend",
        "resource_type": "delivery",
        "context_scope": "diddisend:support-context:read",
        "status": "implemented",
        "endpoint": "/internal/v1/support/delivery/{resource_id}/context"
      },
      {
        "origin_service": "diddipay",
        "resource_type": "withdrawal",
        "context_scope": "diddipay:support-context:read",
        "status": "planned"
      }
    ]
  },
  "http": {
    "user_routes": [
      {
        "method": "POST",
        "path": "/comms/v1/support/cases",
        "operation": "create_case",
        "auth": "user_jwt",
        "idempotency": "required"
      },
      {
        "method": "GET",
        "path": "/comms/v1/support/cases/{case_id}",
        "operation": "read_case",
        "auth": "user_jwt"
      },
      {
        "method": "POST",
        "path": "/comms/v1/support/cases/{case_id}/messages",
        "operation": "send_user_message",
        "auth": "user_jwt",
        "idempotency": "required"
      }
    ],
    "internal_routes": [
      {
        "method": "POST",
        "path": "/support/v1/internal/cases",
        "operation": "create_case_from_owner_module",
        "auth": "service_jwt",
        "required_scope": "diddi-support:cases:create",
        "idempotency": "required",
        "allowed_callers": ["diddicomms", "diddigo", "diddifood", "diddisend"],
        "delegated_origin_supported": true
      },
      {
        "method": "GET",
        "path": "/support/v1/internal/context/{origin_service}/{resource_type}/{resource_id}",
        "operation": "read_business_context",
        "auth": "service_jwt",
        "required_scope": "diddi-support:cases:read",
        "allowed_callers": ["diddicomms"]
      },
      {
        "method": "POST",
        "path": "/support/v1/internal/cases/{case_id}/messages",
        "operation": "create_user_message_from_diddicomms",
        "auth": "service_jwt",
        "required_scope": "diddi-support:messages:write",
        "allowed_callers": ["diddicomms"],
        "idempotency": "required",
        "status": "implemented"
      },
      {
        "method": "GET",
        "path": "/support/v1/internal/cases/{case_id}/messages",
        "operation": "read_user_visible_messages_for_diddicomms",
        "auth": "service_jwt",
        "required_scope": "diddi-support:cases:read",
        "allowed_callers": ["diddicomms"],
        "status": "implemented"
      },
      {
        "method": "GET",
        "path": "/support/v1/internal/cases/{case_id}/context",
        "operation": "read_case_with_business_context",
        "auth": "service_jwt",
        "required_scope": "diddi-support:cases:read",
        "allowed_callers": ["diddicomms"]
      },
      {
        "method": "POST",
        "path": "/support/v1/internal/actions/{action_id}/result",
        "operation": "record_business_action_result",
        "auth": "service_jwt",
        "required_scope": "diddi-support:actions:write"
      }
    ],
    "backoffice_routes": [
      {
        "method": "GET",
        "path": "/support/v1/backoffice/cases/{case_id}/context",
        "operation": "read_case_with_business_context",
        "auth": "user_jwt",
        "required_permission": "diddi-support:read"
      },
      {
        "method": "GET",
        "path": "/support/v1/backoffice/cases",
        "operation": "list_support_cases",
        "auth": "user_jwt",
        "required_permission": "diddi-support:read"
      },
      {
        "method": "POST",
        "path": "/support/v1/backoffice/cases/{case_id}/assign",
        "operation": "assign_support_case",
        "auth": "user_jwt",
        "required_permission": "diddi-support:assign"
      },
      {
        "method": "POST",
        "path": "/support/v1/backoffice/cases/{case_id}/transfer",
        "operation": "transfer_support_case",
        "auth": "user_jwt",
        "required_permission": "diddi-support:assign"
      },
      {
        "method": "POST",
        "path": "/support/v1/backoffice/cases/{case_id}/transition",
        "operation": "transition_support_case",
        "auth": "user_jwt",
        "required_permission": "diddi-support:write"
      },
      {
        "method": "GET",
        "path": "/support/v1/backoffice/cases/{case_id}/timeline",
        "operation": "read_support_timeline",
        "auth": "user_jwt",
        "required_permission": "diddi-support:read"
      },
      {
        "method": "POST",
        "path": "/support/v1/backoffice/actions",
        "operation": "request_business_action",
        "auth": "user_jwt",
        "required_permission": "diddi-support:write"
      },
      {
        "method": "GET",
        "path": "/support/v1/backoffice/actions/{action_id}",
        "operation": "read_business_action",
        "auth": "user_jwt",
        "required_permission": "diddi-support:read"
      },
      {
        "method": "POST",
        "path": "/support/v1/backoffice/cases/{case_id}/handoff",
        "operation": "change_conversation_handoff",
        "auth": "user_jwt",
        "required_permission": "diddi-support:reply"
      },
      {
        "method": "POST",
        "path": "/support/v1/backoffice/cases/{case_id}/messages",
        "operation": "create_support_message",
        "auth": "user_jwt",
        "required_permission": "diddi-support:reply|diddi-support:write"
      },
      {
        "method": "GET",
        "path": "/support/v1/backoffice/cases/{case_id}/messages",
        "operation": "list_support_messages",
        "auth": "user_jwt",
        "required_permission": "diddi-support:read"
      },
      {
        "method": "POST",
        "path": "/support/v1/backoffice/cases/{case_id}/attachments",
        "operation": "reference_support_attachment",
        "auth": "user_jwt",
        "required_permission": "diddi-support:reply"
      },
      {
        "method": "GET",
        "path": "/support/v1/backoffice/cases/{case_id}/attachments",
        "operation": "list_support_attachments",
        "auth": "user_jwt",
        "required_permission": "diddi-support:attachments-read"
      },
      {
        "method": "POST",
        "path": "/support/v1/backoffice/cases/{case_id}/attachments/{attachment_id}/temporary-access",
        "operation": "create_temporary_attachment_access",
        "auth": "user_jwt",
        "required_permission": "diddi-support:attachments-read"
      },
      {
        "method": "GET",
        "path": "/support/v1/backoffice/sos",
        "operation": "list_sos_queue",
        "auth": "user_jwt",
        "required_permission": "diddi-support:read"
      },
      {
        "method": "POST",
        "path": "/support/v1/backoffice/sos/{alert_id}/confirm",
        "operation": "confirm_sos",
        "auth": "user_jwt",
        "required_permission": "diddi-support:sos-operate"
      },
      {
        "method": "POST",
        "path": "/support/v1/backoffice/sos/{alert_id}/start",
        "operation": "start_sos_handling",
        "auth": "user_jwt",
        "required_permission": "diddi-support:sos-operate"
      },
      {
        "method": "POST",
        "path": "/support/v1/backoffice/sos/{alert_id}/complete",
        "operation": "complete_sos_handling",
        "auth": "user_jwt",
        "required_permission": "diddi-support:sos-operate"
      },
      {
        "method": "POST",
        "path": "/support/v1/backoffice/sos/{alert_id}/retry-notification",
        "operation": "retry_sos_notification",
        "auth": "user_jwt",
        "required_permission": "diddi-support:sos-operate"
      }
    ],
    "context_routes_expected_from_owner": [
      {
        "method": "GET",
        "path": "/internal/v1/support/{resource_type}/{resource_id}/context",
        "operation": "read_limited_business_context",
        "caller_scope_pattern": "{owner}:support-context:read"
      }
    ]
  },
  "events": {
    "delivery": "at_least_once",
    "deduplication_key": "event_id",
    "events": [
      "support.case.created.v1",
      "support.case.updated.v1",
      "support.case.assigned.v1",
      "support.case.message.created.v1",
      "support.case.resolved.v1",
      "support.sos.created.v1",
      "support.sos.acknowledged.v1",
      "support.sos.escalated.v1",
      "support.sos.notification.requested.v1",
      "support.action.requested.v1",
      "support.action.completed.v1",
      "support.action.failed.v1"
    ]
  },
  "attachments": {
    "provider": "diddifiles",
    "file_reference": "file_id_only",
    "purposes": [
      "diddisupport_case_photo",
      "diddisupport_case_voice",
      "diddisupport_case_document"
    ],
    "public_urls_allowed": false,
    "temporary_access_required": true
  },
  "reliability": {
    "transactional_outbox": true,
    "event_stream": "diddisupport.events",
    "event_envelope": "support.event.v1",
    "deduplicate_by": "event_id",
    "inbox_deduplication": true,
    "retry_after_timeout": "recover_original_operation",
    "websocket_is_source_of_truth": false,
    "ai_outage_must_preserve_case_creation": true,
    "chat_outage_must_preserve_case_creation": true
  },
  "backoffice": {
    "integration": "diddicomms",
    "required_resources": [
      "support_case_queue",
      "support_sos_queue",
      "support_case_detail",
      "support_action_history"
    ],
    "required_permissions": [
      "diddi-support:read",
      "diddi-support:reply",
      "diddi-support:assign",
      "diddi-support:sos-operate",
      "diddi-support:attachments-read",
      "diddi-support:audit-read"
    ]
  },
  "compatibility": {
    "manifest_distribution": "git_versioned",
    "public_discovery_endpoint": false,
    "breaking_change": "new_major_manifest_version",
    "contract_tests_required": true
  }
}
