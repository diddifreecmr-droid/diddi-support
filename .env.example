APP_NAME=diddi-support
APP_ENV=local
LOG_LEVEL=INFO
PORT=8050
REQUIRE_DEPENDENCIES=false
MANIFEST_PATH=manifests/diddi-support.v1.json
IDENTITY_JWKS_URL=
IDENTITY_ISSUER=diddifree-id
SERVICE_AUDIENCE=diddi-support
BACKOFFICE_AUDIENCE=diddi-comms-backoffice
DATABASE_URL=postgresql+asyncpg://diddi_support:diddi_support@postgres:5432/diddi_support
REDIS_URL=redis://redis:6379/0
CONTEXT_CONNECTORS_JSON={}
CONTEXT_REQUEST_TIMEOUT_SECONDS=3
CONTEXT_AUTH_TOKEN=
CONTEXT_CLIENT_ID=
CONTEXT_READER_ALLOWED_SERVICES=diddicomms
DIDDICOMMS_SERVICE_CLIENT_ID=
DIDDIFREEID_SERVICE_TOKEN_URL=
DIDDISUPPORT_DIDDIGO_BASE_URL=https://go-staging.diddifree.com
DIDDISUPPORT_DIDDIGO_SERVICE_CLIENT_ID=
DIDDISUPPORT_DIDDIGO_SERVICE_CLIENT_SECRET=
DIDDISUPPORT_DIDDIGO_SERVICE_AUDIENCE=diddigo
DIDDISUPPORT_DIDDIGO_SERVICE_SCOPE=diddigo:support-context:read
DIDDISUPPORT_DIDDISEND_BASE_URL=http://diddisend-api-staging.diddifree.com
DIDDISUPPORT_DIDDISEND_SERVICE_CLIENT_ID=
DIDDISUPPORT_DIDDISEND_SERVICE_CLIENT_SECRET=
DIDDISUPPORT_DIDDISEND_SERVICE_AUDIENCE=diddisend
DIDDISUPPORT_DIDDISEND_SERVICE_SCOPE=diddisend:support-context:read
DIDDIFILES_BASE_URL=
DIDDIFILES_AUTH_TOKEN=
DIDDIFILES_CLIENT_ID=
ATTACHMENT_MAX_BYTES=10485760
SOS_MAX_NOTIFICATION_ATTEMPTS=3
SOS_ESCALATION_AFTER_SECONDS=60
