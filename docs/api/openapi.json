{
  "openapi": "3.1.0",
  "info": {
    "title": "diddi-support",
    "version": "1.0"
  },
  "paths": {
    "/support/v1/internal/cases": {
      "post": {
        "tags": [
          "internal-support"
        ],
        "summary": "Create Case",
        "operationId": "create_case_support_v1_internal_cases_post",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Idempotency-Key"
            }
          },
          {
            "name": "Authorization",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          },
          {
            "name": "X-Client-ID",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Client-Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateCaseRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CaseResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/health/live": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Liveness",
        "operationId": "liveness_health_live_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Liveness Health Live Get"
                }
              }
            }
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Readiness",
        "operationId": "readiness_health_ready_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/support/v1/ping": {
      "get": {
        "tags": [
          "support"
        ],
        "summary": "Ping",
        "operationId": "ping_support_v1_ping_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Ping Support V1 Ping Get"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CasePriority": {
        "type": "string",
        "enum": [
          "low",
          "normal",
          "high",
          "critical"
        ],
        "title": "CasePriority"
      },
      "CaseResponse": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "origin_service": {
            "type": "string",
            "title": "Origin Service"
          },
          "resource_type": {
            "type": "string",
            "title": "Resource Type"
          },
          "resource_id": {
            "type": "string",
            "format": "uuid",
            "title": "Resource Id"
          },
          "reporter_user_id": {
            "type": "string",
            "format": "uuid",
            "title": "Reporter User Id"
          },
          "category": {
            "type": "string",
            "title": "Category"
          },
          "subject": {
            "type": "string",
            "title": "Subject"
          },
          "priority": {
            "$ref": "#/components/schemas/CasePriority"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "created": {
            "type": "boolean",
            "title": "Created"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "origin_service",
          "resource_type",
          "resource_id",
          "reporter_user_id",
          "category",
          "subject",
          "priority",
          "status",
          "created"
        ],
        "title": "CaseResponse"
      },
      "CreateCaseRequest": {
        "properties": {
          "origin_service": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{1,63}$",
            "title": "Origin Service"
          },
          "resource_type": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{1,63}$",
            "title": "Resource Type"
          },
          "resource_id": {
            "type": "string",
            "format": "uuid",
            "title": "Resource Id"
          },
          "origin_report_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 160
              },
              {
                "type": "null"
              }
            ],
            "title": "Origin Report Id"
          },
          "reporter_user_id": {
            "type": "string",
            "format": "uuid",
            "title": "Reporter User Id"
          },
          "category": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Category"
          },
          "subject": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Subject"
          },
          "priority": {
            "$ref": "#/components/schemas/CasePriority",
            "default": "normal"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "origin_service",
          "resource_type",
          "resource_id",
          "reporter_user_id",
          "category",
          "subject"
        ],
        "title": "CreateCaseRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}\n